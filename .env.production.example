# ==============================================================================
# Medipaedia Healthcare & Pharmacy Platform - Production Environment Variables
# Copy this template to .env.production or export in your CI/CD secrets manager
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Global Deployment Config
# ------------------------------------------------------------------------------
ENVIRONMENT=production
PROJECT_NAME="Medipaedia Core API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
DEBUG=false

# ------------------------------------------------------------------------------
# 2. Database Configuration (PostgreSQL 16 + PostGIS)
# ------------------------------------------------------------------------------
POSTGRES_USER=medipaedia_prod
POSTGRES_PASSWORD=CHANGE_ME_TO_A_SECURE_PASSWORD_32_CHARS_MIN
POSTGRES_DB=medipaedia_db
POSTGRES_SERVER=db
POSTGRES_PORT=5432

# Production Async SQLAlchemy Connection String (Asyncpg)
DATABASE_URL=postgresql+asyncpg://medipaedia_prod:CHANGE_ME_TO_A_SECURE_PASSWORD_32_CHARS_MIN@db:5432/medipaedia_db

# Production Synchronous Connection String (Psycopg2 / Alembic migrations)
SYNC_DATABASE_URL=postgresql://medipaedia_prod:CHANGE_ME_TO_A_SECURE_PASSWORD_32_CHARS_MIN@db:5432/medipaedia_db

# ------------------------------------------------------------------------------
# 3. Redis Configuration (Cache, Real-Time OPD Queue & Rate Limiting)
# ------------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_TO_A_STRONG_REDIS_PASSWORD_2026!
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://:CHANGE_ME_TO_A_STRONG_REDIS_PASSWORD_2026!@redis:6379/0

# ------------------------------------------------------------------------------
# 4. Cryptographic Security, JWT & Clinical Digital Signatures
# ------------------------------------------------------------------------------
# High-entropy JWT Signing Secret (Minimum 64 characters recommended)
JWT_SECRET=super_secret_jwt_production_master_key_minimum_64_characters_medipaedia_2026_xyz
SECRET_KEY=super_secret_jwt_production_master_key_minimum_64_characters_medipaedia_2026_xyz
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Platform Super Administrator Master Credentials
ADMIN_ROOT_EMAIL=elzakari@easymsdigit.com
ADMIN_ROOT_PASSWORD=Barbie@1983#2026

# HMAC-SHA256 Secret for Immutable E-Prescription QR & Dispensing Signatures
HMAC_SECRET_KEY=production_clinical_hmac_prescription_qr_verification_secret_32bytes_key
PRESCRIPTION_HMAC_SECRET=production_clinical_hmac_prescription_qr_verification_secret_32bytes_key

# ------------------------------------------------------------------------------
# 5. Payment Gateways (West Africa Escrow, GHS, XOF, Mobile Money)
# ------------------------------------------------------------------------------
# Paystack Live API Keys (Ghana Cedis GHS, Nigeria NGN)
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# FedaPay Live API Keys (Benin & Togo Mobile Money - MTN, Moov XOF)
FEDAPAY_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEDAPAY_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEDAPAY_ENVIRONMENT=live

# Hub2 Live Secret Key (Francophone West Africa Gateway)
HUB2_SECRET_KEY=hub2_live_secret_key_production_xof_2026

# Marketplace Platform Commission
PLATFORM_COMMISSION_PERCENT=5.0

# ------------------------------------------------------------------------------
# 6. Frontend Domain & Public Gateway Routing
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://api.medipaedia.health
NEXT_PUBLIC_DEFAULT_CURRENCY=GHS
NEXT_PUBLIC_DEFAULT_COUNTRY=GH

# CORS Allowed Origins (JSON Array format)
BACKEND_CORS_ORIGINS='["https://clinical.medipaedia.health","https://rx.medipaedia.health","https://care.medipaedia.health","https://api.medipaedia.health"]'

# ------------------------------------------------------------------------------
# 7. Default Geolocation Coordinates (Accra Standard)
# ------------------------------------------------------------------------------
DEFAULT_LATITUDE=5.6037
DEFAULT_LONGITUDE=-0.1870
DEFAULT_COUNTRY=GH
DEFAULT_CURRENCY=GHS

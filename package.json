{
  "name": "medipaedia-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:turbo": "turbo run dev",
    "dev:apps": "turbo run dev --filter=\"./apps/*\"",
    "dev:hospital": "turbo run dev --filter=@medipaedia/hospital-web",
    "dev:pharmacy": "turbo run dev --filter=@medipaedia/pharmacy-pos",
    "dev:patient": "turbo run dev --filter=@medipaedia/patient-store",
    "dev:api": "cd services/core-api && uvicorn app.main:app --reload --port 8000",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,js}\"",
    "docker:up": "docker compose -f docker/docker-compose.dev.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.dev.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.dev.yml logs -f",
    "db:migrate": "cd services/core-api && alembic upgrade head",
    "db:makemigrations": "cd services/core-api && alembic revision --autogenerate -m",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.3"
  },
  "packageManager": "pnpm@9.14.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
